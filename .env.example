# Copy this file to .env and replace both values with long secret values.
# Never commit or publish the real .env file.
PUSHBULLET_ACCESS_TOKEN=put_your_pushbullet_access_token_here
ADMIN_PASSWORD=replace_with_a_long_random_password
# Keep at 0 when accessing the app directly. Configure carefully behind a trusted reverse proxy.
TRUST_PROXY=0
